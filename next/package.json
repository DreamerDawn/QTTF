{
  "name": "qttf-website-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "QTTF（丘班乒乓球联合会）重构版静态站点：Vite 多页面 + 原生 Web Components 风格组件 + Decap CMS",
  "scripts": {
    "dev": "concurrently -k -n site,cms -c blue,magenta \"vite\" \"decap-server\"",
    "dev:site": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs",
    "check": "node scripts/validate-data.mjs && vite build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "decap-server": "^3.11.5",
    "js-yaml": "^5.5.0",
    "postcss": "^8.5.6",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.28.5"
}
